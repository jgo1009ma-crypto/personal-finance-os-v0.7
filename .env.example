# Optional. Without this key the Copilot runs in deterministic local mode.
OPENAI_API_KEY=

# Balanced default for the financial copilot. You can also use gpt-5.6-sol or gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Usually leave this unchanged.
OPENAI_BASE_URL=https://api.openai.com/v1
