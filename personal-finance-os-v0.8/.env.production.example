# Durable cloud database. Use the pooled Neon connection string.
DATABASE_URL=postgresql://...

# Single-user private access. Use a long random password.
APP_PASSWORD=replace-with-a-long-random-password
# Generate another long random secret; used to sign the HttpOnly session cookie.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# OpenAI remains server-side only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Optional: expected public origin. Enables strict Origin checks on writes.
APP_ORIGIN=https://your-project.vercel.app
